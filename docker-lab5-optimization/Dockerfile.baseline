FROM node:24
WORKDIR /app
# A realistic single-stage development image keeps the full Node distribution,
# frontend build tools, source files and package-manager cache at runtime.
COPY client/ ./client/
COPY server/ ./server/
RUN cd client && npm ci --no-audit --no-fund && npm run build
RUN cd server && npm ci --no-audit --no-fund
RUN cp -r client/build server/build
WORKDIR /app/server
ENV PORT=3000
EXPOSE 3000
CMD ["node", "server.js"]
